# Copia este ficheiro para .env e preenche os valores reais
# NUNCA commites o ficheiro .env para o Git!

# Google OAuth2
# Cria em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Geoapify (geocoding + hotéis)
# Registo gratuito: https://www.geoapify.com/
GEOAPIFY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap (meteorologia)
# Registo gratuito: https://openweathermap.org/api
OPENWEATHER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RapidAPI — Google Flights (DataCrawler)
# Registo: https://rapidapi.com/DataCrawler/api/google-flights2
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base de dados — só necessário se usares docker-compose up (opcional por agora)
# DB_USER=travelbuddy
# DB_PASS=travelbuddy123
